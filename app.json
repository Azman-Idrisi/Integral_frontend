{
  "expo": {
    "name": "Integral Student Portal",
    "slug": "ISP",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "frontend",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "com.azman.integral",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F2F9FF",
          "image": "./assets/icon.png",
          "imageWidth": 200,
          "dark": {
            "backgroundColor": "#051014",
            "image": "./assets/icon.png"
          }
        }
      ],
      "expo-image",
      "expo-web-browser",
      "expo-font",
      "expo-status-bar",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      "./plugins/withOptionalPortraitFeature"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "cdfb4e3c-d8b3-4093-a941-7c8f1bdc3829"
      }
    },
    "owner": "azman_idrisi"
  }
}
